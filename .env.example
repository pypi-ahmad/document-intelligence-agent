# Copy this file to .env and fill in your own values.
# Real machine/user environment variables always take precedence over .env.

# --- Local models (Ollama) -------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b
EMBED_MODEL=nomic-embed-text-v2-moe

# --- GPT via an OpenAI-compatible endpoint ---------------------------------
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Agnes AI (optional alternative "complex" LLM provider) ----------------
# Docs: https://www.agnes-ai.com/en/docs/overview
AGNES_API_KEY=...
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# Which provider answers multi-hop / verification / comparison questions:
# "openai" (default) or "agnes"
COMPLEX_LLM_PROVIDER=openai

# --- ArcadeDB ---------------------------------------------------------------
ARCADEDB_HOST=localhost
ARCADEDB_PORT=2480
ARCADEDB_DATABASE=docintel
ARCADEDB_USER=root
ARCADEDB_PASSWORD=playwithdata

# --- Chunking / retrieval tuning --------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K_VECTOR=8
TOP_K_FINAL=6
MAX_HOPS=2
LLM_TEMPERATURE=0.1
